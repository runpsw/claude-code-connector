page { background: #f6f6f6; color: #222; font-size: 28rpx; }
.card { background: #fff; border-radius: 16rpx; margin: 20rpx; overflow: hidden; }
.cover { width: 100%; height: 300rpx; display: block; background: #e8dccf; }
.pad { padding: 20rpx 24rpx; }
.title { font-size: 32rpx; font-weight: 600; }
.sub { color: #888; font-size: 24rpx; margin-top: 8rpx; }
.price { color: #b8562b; font-size: 34rpx; font-weight: 600; }
.row { display: flex; justify-content: space-between; align-items: center; }
.btn { background: #b8562b; color: #fff; border-radius: 40rpx; font-size: 28rpx; }
.btn[disabled] { background: #ccc; color: #fff; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -2rpx 10rpx rgba(0,0,0,.05); }
.bottom-bar .btn { width: 300rpx; margin: 0; }
.progress { height: 12rpx; background: #eee; border-radius: 6rpx; overflow: hidden; margin-top: 12rpx; }
.progress > view { height: 100%; background: #b8562b; }
