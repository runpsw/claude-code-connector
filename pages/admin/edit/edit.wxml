<view class="card pad" style="margin-bottom:180rpx">
  <view class="f"><text>名称</text><input value="{{form.title}}" data-k="title" bindinput="onInput" placeholder="必填" /></view>
  <view class="f"><text>价格（元）</text><input type="digit" value="{{form.price}}" data-k="price" bindinput="onInput" /></view>
  <block wx:if="{{type==='course'}}">
    <view class="f"><text>老师</text><input value="{{form.teacher}}" data-k="teacher" bindinput="onInput" /></view>
  </block>
  <block wx:else>
    <view class="f"><text>时间</text><input value="{{form.date}}" data-k="date" bindinput="onInput" placeholder="如 2026-10-18 09:00" /></view>
    <view class="f"><text>地点</text><input value="{{form.place}}" data-k="place" bindinput="onInput" /></view>
    <view class="f"><text>名额</text><input type="number" value="{{form.left}}" data-k="left" bindinput="onInput" /></view>
  </block>
  <view class="f col"><text>简介</text><textarea value="{{form.desc}}" data-k="desc" bindinput="onInput" maxlength="1000" auto-height /></view>
  <view class="f col" wx:if="{{type==='course'}}"><text>课程目录（每行一节）</text><textarea value="{{form.lessonsText}}" data-k="lessonsText" bindinput="onInput" auto-height style="min-height:200rpx" /></view>
  <view class="f col">
    <text>封面</text>
    <image wx:if="{{form.cover}}" src="{{form.cover}}" mode="aspectFill" style="width:100%;height:240rpx" />
    <button size="mini" bindtap="pick">选择图片</button>
  </view>
</view>
<view class="bottom-bar"><button class="btn" style="width:100%" bindtap="save">保存</button></view>
